# ====================
# JUGADOR
# ====================

class Jugador:

    def __init__(
        self,
        x,
        y,
        color,
        nombre
    ):

        self.x = x
        self.y = y

        self.color = color
        self.nombre = nombre

        self.rect = pygame.Rect(
            x,
            y,
            40,
            50
        )

        self.velocidad = 220

    def mover(
        self,
        teclas,
        controles,
        dt
    ):

        if teclas[controles[0]]:
            self.y -= self.velocidad * dt

        if teclas[controles[1]]:
            self.y += self.velocidad * dt

        if teclas[controles[2]]:
            self.x -= self.velocidad * dt

        if teclas[controles[3]]:
            self.x += self.velocidad * dt

        self.x = max(
            0,
            min(
                ANCHO-40,
                self.x
            )
        )

        self.y = max(
            0,
            min(
                ALTO-50,
                self.y
            )
        )

        self.rect.x = self.x
        self.rect.y = self.y

    def dibujar(self):

        # cuerpo

        pygame.draw.rect(
            pantalla,
            self.color,
            self.rect,
            border_radius=12
        )

        # visor

        pygame.draw.rect(
            pantalla,
            (180,220,255),
            (
                self.rect.x+8,
                self.rect.y+10,
                22,
                12
            ),
            border_radius=5
        )

        # nombre

        txt = fuente.render(
            self.nombre,
            True,
            BLANCO
        )

        pantalla.blit(
            txt,
            (
                self.rect.x-5,
                self.rect.y-30
            )
        )


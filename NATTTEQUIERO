# ====================

def crear_jugadores(total):

    jugadores.clear()

    posiciones = [

        (300,350),
        (400,350),
        (500,350),
        (600,350)

    ]

    for i in range(total):

        x,y = posiciones[i]

        jugadores.append(

            Jugador(
                x,
                y,
                colores[i],
                roles[i]
            )

        )

def dibujar_nave():

    for nombre,sala in salas.items():

        pygame.draw.rect(
            pantalla,
            PANEL,
            sala,
            border_radius=12
        )

        pygame.draw.rect(
            pantalla,
            BLANCO,
            sala,
            2,
            border_radius=12
        )

        txt = fuente.render(
            nombre,
            True,
            BLANCO
        )

        pantalla.blit(
            txt,
            (
                sala.x+20,
                sala.y+20
            )
        )

def mostrar_mision():

    if mision_actual < len(misiones):

        texto_mision = misiones[mision_actual]

        texto_dibujar = fuente.render(

            f"OBJETIVO: {texto_mision['texto']}",

            True,

            AMARILLO

        )

        pantalla.blit(
            texto_dibujar,
            (20,20)
        )

# ====================
# LOOP
# ====================

while True:

    dt = clock.tick(60)/1000

    for evento in pygame.event.get():

        if evento.type == pygame.QUIT:

            pygame.quit()
            sys.exit()

        if evento.type == pygame.KEYDOWN:

            if estado == "menu":

                if evento.key == pygame.K_1:

                    crear_jugadores(1)
                    estado = "juego"

                elif evento.key == pygame.K_2:

                    crear_jugadores(2)
                    estado = "juego"

                elif evento.key == pygame.K_3:

                    crear_jugadores(3)
                    estado = "juego"

                elif evento.key == pygame.K_4:

                    crear_jugadores(4)
                    estado = "juego"

            if estado == "juego":

                if evento.key == pygame.K_e:

                    if mision_actual < len(misiones):

                        objetivo = misiones[mision_actual]

                        for j in jugadores:

                            if j.nombre == objetivo["rol"]:

                                if j.rect.colliderect(

                                    salas[objetivo["sala"]]

                                ):

                                    mision_actual += 1

    pantalla.fill(FONDO)

    # ====================
    # MENU
    # ====================

    if estado == "menu":

        txt = titulo.render(
            "APOLLO 13",
            True,
            BLANCO
        )

        pantalla.blit(
            txt,
            (430,120)
        )

        info = [

            "1 Jugador",
            "2 Jugadores",
            "3 Jugadores",
            "4 Jugadores"

        ]

        y = 280

        for i in info:

            t = fuente.render(
                i,
                True,
                AMARILLO
            )

            pantalla.blit(
                t,
                (560,y)
            )

            y += 60

    # ====================
    # JUEGO
    # ====================

    elif estado == "juego":

        teclas = pygame.key.get_pressed()

        dibujar_nave()

        mostrar_mision()

        for indice,jugador in enumerate(jugadores):

            jugador.mover(
                teclas,
                controles[indice],
                dt
            )

            jugador.dibujar()

            for nombre,sala in salas.items():

                if jugador.rect.colliderect(sala):

                    txt = fuente.render(
                        "E",
                        True,
                        VERDE
                    )

                    pantalla.blit(
                        txt,
                        (
                            sala.x+100,
                            sala.y-35
                        )
                    )

        if mision_actual >= len(misiones):

            fin = titulo.render(
                "MISIÓN COMPLETADA",
                True,
                VERDE
            )

            pantalla.blit(
                fin,
                (300,300)
            )

    pygame.display.flip()


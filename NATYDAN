# JUGADOR
# ====================

class Jugador:

    def __init__(
        self,
        x,
        y,
        color,
        nombre
    ):

        self.x = x
        self.y = y

        self.color = color
        self.nombre = nombre

        self.rect = pygame.Rect(
            x,
            y,
            28,
            36
        )

        self.velocidad = 250

    def hitbox(self, x, y):
        # Solo los pies colisionan con las paredes.
        return pygame.Rect(int(x) + 5, int(y) + 23, 18, 10)

    def mover(
        self,
        teclas,
        controles,
        dt
    ):

        dx = 0
        dy = 0

        if teclas[controles[0]]:
            dy -= self.velocidad * dt

        if teclas[controles[1]]:
            dy += self.velocidad * dt

        if teclas[controles[2]]:
            dx -= self.velocidad * dt

        if teclas[controles[3]]:
            dx += self.velocidad * dt

        # Cada eje por separado para poder deslizarse por las paredes.
        if dx and hitbox_valida(self.hitbox(self.x + dx, self.y)):
            self.x += dx

        if dy and hitbox_valida(self.hitbox(self.x, self.y + dy)):
            self.y += dy

        self.rect.x = self.x
        self.rect.y = self.y

    def dibujar(self):
        x, y = self.rect.x, self.rect.y
        centro_x = self.rect.centerx

        pygame.draw.ellipse(pantalla, (0, 0, 0, 90), (x + 2, y + 31, 24, 6))
        pygame.draw.rect(pantalla, (24, 35, 53), (x + 2, y + 18, 6, 14), border_radius=3)
        pygame.draw.rect(pantalla, self.color, (x + 6, y + 17, 17, 16), border_radius=6)
        pygame.draw.rect(pantalla, BLANCO, (x + 11, y + 22, 7, 7), border_radius=2)
        pygame.draw.line(pantalla, (220, 232, 245), (x + 10, y + 32), (x + 8, y + 36), 3)
        pygame.draw.line(pantalla, (220, 232, 245), (x + 20, y + 32), (x + 22, y + 36), 3)

        pygame.draw.circle(pantalla, (18, 30, 48), (centro_x, y + 11), 10)
        pygame.draw.circle(pantalla, self.color, (centro_x, y + 10), 9)
        visor = pygame.Rect(x + 5, y + 6, 18, 8)
        pygame.draw.rect(pantalla, (118, 198, 237), visor, border_radius=4)
        pygame.draw.line(pantalla, (224, 248, 255), (x + 8, y + 7), (x + 18, y + 7), 1)

        placa = fuente_mini.render(self.nombre, True, BLANCO)
        placa_rect = placa.get_rect(center=(centro_x, y - 10))
        fondo_placa = placa_rect.inflate(12, 6)
        pygame.draw.rect(pantalla, (8, 17, 31), fondo_placa, border_radius=6)
        pygame.draw.rect(pantalla, self.color, fondo_placa, 1, border_radius=6)
        pantalla.blit(placa, placa_rect)


                texto(str(opcion_i + 1), fuente_micro, color_opcion,
                      (caja.x + 4, caja.y + 3), sombra=False)
                lineas_opcion = partir_texto(opcion, fuente_micro, caja.width - 24)
                limite = max(1, (caja.height - 6) // 13)

    tipo = MJ_POR_MISION.get(indice)
    if tipo == "interruptores":
        estados = [True] * 12
        for i in random.sample(range(12), 6):      # parte de lo resuelto: siempre tiene solución
            for v in _vecinos(i):
                estados[v] = not estados[v]
        if all(estados):

    pantalla.blit(mensaje, mensaje.get_rect(center=(640,260)))
    detalle = fuente.render("La misión ha fallado por falta de tiempo.", True, BLANCO)
    pantalla.blit(detalle, detalle.get_rect(center=(640,310)))
    pantalla.blit(fuente.render("Pulsa ENTER para volver al menú", True, SUAVE), (460,390))

# Inicialización para que no marque error en ZONAS, PUERTAS, etc.
# Debes copiar definiciones originales arriba de las funciones que las usan para evitar errores.

while True:
    dt = clock.tick(60)/1000
    tiempo = pygame.time.get_ticks() / 1000
    mouse = convertir_mouse(pygame.mouse.get_pos())

    for evento in pygame.event.get():
        if evento.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if estado == "menu":
            if evento.type == pygame.MOUSEBUTTONDOWN and evento.button == 1:
                posicion_mouse = convertir_mouse(evento.pos)
                for i, boton in enumerate(botones_menu):
                    if boton.collidepoint(posicion_mouse):
                        crear_jugadores(i+1)
                        estado = "juego"
                        break
            if evento.type == pygame.KEYDOWN and pygame.K_1 <= evento.key <= pygame.K_4:
                crear_jugadores(evento.key - pygame.K_0)
                estado = "juego"

        elif estado == "juego":
            if evento.type == pygame.KEYDOWN and evento.key == pygame.K_ESCAPE:
                estado = "menu"
                jugadores.clear()

        elif estado in ("final","fallo"):
            if evento.type == pygame.KEYDOWN and evento.key in (pygame.K_RETURN, pygame.K_r):
                estado = "menu"
                jugadores.clear()

        if evento.type == pygame.KEYDOWN and evento.key == pygame.K_F11:
            cambiar_modo_pantalla()

    if estado == "menu":
        dibujar_menu(mouse, tiempo)
    elif estado == "juego":
        teclas = pygame.key.get_pressed()
        dibujar_fondo(tiempo)
        dibujar_cabecera()
        mostrar_mision()
        dibujar_nave(tiempo, mouse)
        dibujar_tripulacion()
        for i, jugador in enumerate(jugadores):
            jugador.mover(teclas, controles[i], dt)
            jugador.dibujar()
        actualizar_interaccion(teclas[pygame.K_e], dt)
    elif estado == "final":
        dibujar_final()
    elif estado == "fallo":
        dibujar_fallo()

    presentar_pantalla()


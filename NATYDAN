                    crear_jugadores(evento.key - pygame.K_0)
                    estado = "juego"

            elif estado == "ficha":
                manejar_evento_ficha(evento)

            elif estado == "juego":
                if evento.type == pygame.KEYDOWN:
                    if evento.key == pygame.K_ESCAPE:
                        tiempo_pausa = tiempo
                        estado = "pausa"
                    elif evento.key == pygame.K_m:
                        tiempo_pausa = tiempo
                        estado = "mapa"

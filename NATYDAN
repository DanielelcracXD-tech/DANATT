def _vecinos(i):
    c, f = i % 4, i // 4
    res = [i]
    if f > 0:
        res.append(i - 4)
    if f < 2:
        res.append(i + 4)
    if c > 0:
        res.append(i - 1)
    if c < 3:
        res.append(i + 1)
    return res



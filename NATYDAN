        mj.update(tipo=tipo, estados=estados)
    elif tipo == "adaptador":
        orden = list(range(len(ADAPTADOR_ITEMS)))
        random.shuffle(orden)
        mj.update(tipo=tipo, orden=orden, elegidos=set())
    elif tipo == "alinear":

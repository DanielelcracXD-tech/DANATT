def mezclar(c1, c2, t):
    """Interpola dos colores RGB con un factor limitado al intervalo 0..1."""
    t = max(0.0, min(1.0, t))
    return tuple(int(a + (b - a) * t) for a, b in zip(c1[:3], c2[:3]))


def suave(t):
    """Aplica una curva de entrada/salida cúbica a un progreso normalizado."""
    t = max(0.0, min(1.0, t))
    return 1 - (1 - t) ** 3


@lru_cache(maxsize=2048)
def _renderizar_texto(cadena, fnt, color):
    return fnt.render(cadena, True, color)


def texto(cadena, fnt, color, pos, centro=False, derecha=False, sombra=True):
    """Dibuja texto alineado en el lienzo y devuelve el rectángulo que ocupa."""
    if not cadena:
        return pygame.Rect(pos[0], pos[1], 0, 0)
    color = tuple(color)
    img = _renderizar_texto(cadena, fnt, color)
    r = img.get_rect()
    if centro:
        r.center = pos
    elif derecha:
        r.topright = pos
    else:
        r.topleft = pos
    if sombra:
        pantalla.blit(_renderizar_texto(cadena, fnt, (2, 5, 12)), r.move(1, 1))
    pantalla.blit(img, r)
    return r


def partir_texto(cadena, fnt, ancho):
    """Divide una cadena en líneas que caben dentro del ancho indicado."""
    lineas, actual = [], ""
    for palabra in cadena.split():
        prueba = (actual + " " + palabra).strip()
        if fnt.size(prueba)[0] <= ancho:
            actual = prueba
        else:
            lineas.append(actual)
            actual = palabra
    if actual:
        lineas.append(actual)
    return lineas


def _crear_superficie_rect_alpha(ancho, alto, color, alpha, radio, borde):
    superficie = pygame.Surface((ancho, alto), pygame.SRCALPHA)
    pygame.draw.rect(superficie, (*color, alpha), superficie.get_rect(), borde, border_radius=radio)
    return superficie


@lru_cache(maxsize=32)
def _superficie_rect_alpha(ancho, alto, color, alpha, radio, borde):
    return _crear_superficie_rect_alpha(ancho, alto, color, alpha, radio, borde)


def rect_alpha(destino, color, rect, alpha, radio=8, borde=0):
    """Dibuja un rectángulo redondeado con transparencia sobre una superficie."""
    color_rgb = tuple(color[:3])
    opacidad = max(0, min(255, int(alpha)))
    if rect.width * rect.height <= 200_000:
        superficie = _superficie_rect_alpha(rect.width, rect.height, color_rgb, opacidad, radio, borde)
    else:
        superficie = _crear_superficie_rect_alpha(rect.width, rect.height, color_rgb, opacidad, radio, borde)
    destino.blit(superficie, rect.topleft)


def fmt_met(seg):
    """Formatea segundos como una hora MET de tres dígitos (HHH:MM:SS)."""
    seg = int(seg)
    return f"{seg // 3600:03d}:{(seg % 3600) // 60:02d}:{seg % 60:02d}"


# Partículas decorativas: cada una conserva posición, velocidad, color y vida útil.

particulas = []


def emitir(x, y, color, n=24, vel=180, vida=0.9, r=3, grav=0.0):
    """Añade partículas aleatorias alrededor de un punto."""
    for _ in range(n):
        a = random.random() * math.tau
        v = random.uniform(0.3, 1.0) * vel
        particulas.append({"x": x, "y": y, "vx": math.cos(a) * v, "vy": math.sin(a) * v, "t": 0.0,
                           "vida": vida * random.uniform(0.6, 1.1), "c": color,
                           "r": r * random.uniform(0.6, 1.3), "g": grav})


def actualizar_particulas(dt):
    """Avanza las partículas por el tiempo transcurrido y elimina las expiradas."""
    for p in particulas:
        p["t"] += dt
        p["x"] += p["vx"] * dt
        p["y"] += p["vy"] * dt
        p["vy"] += p["g"] * dt
        p["vx"] *= 0.985
    particulas[:] = [p for p in particulas if p["t"] < p["vida"]]


def dibujar_particulas():
    """Dibuja las partículas con color y tamaño atenuados según su vida restante."""
    for p in particulas:
        k = 1 - p["t"] / p["vida"]
        pygame.draw.circle(pantalla, mezclar((6, 12, 24), p["c"], k), (int(p["x"]), int(p["y"])),
                           max(1, int(p["r"] * k + 0.5)))



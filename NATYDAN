def cambiar_modo_pantalla():
    global ventana, pantalla_completa
    pantalla_completa = not pantalla_completa
    if pantalla_completa:
        ventana = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
    else:
        ventana = pygame.display.set_mode((ANCHO, ALTO), pygame.RESIZABLE)

def convertir_mouse(posicion):
    ancho_ventana, alto_ventana = ventana.get_size()
    escala = min(ancho_ventana / ANCHO, alto_ventana / ALTO)
    ancho_vista = round(ANCHO * escala)
    alto_vista = round(ALTO * escala)
    origen_x = (ancho_ventana - ancho_vista) // 2
    origen_y = (alto_ventana - alto_vista) // 2
    x = round((posicion[0] - origen_x) / escala)
    y = round((posicion[1] - origen_y) / escala)
    return x, y

def presentar_pantalla():
    ancho_ventana, alto_ventana = ventana.get_size()
    escala = min(ancho_ventana / ANCHO, alto_ventana / ALTO)
    ancho_vista = max(1, round(ANCHO * escala))
    alto_vista = max(1, round(ALTO * escala))
    vista = pygame.transform.smoothscale(pantalla, (ancho_vista, alto_vista))
    ventana.fill((0, 0, 0))
    ventana.blit(vista, ((ancho_ventana - ancho_vista) // 2,
                         (alto_ventana - alto_vista) // 2))
    pygame.display.flip()


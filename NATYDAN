def crear_jugadores(total):
    global mision_actual, progreso_interaccion, tiempo_total
    jugadores.clear()
    mision_actual = 0
    progreso_interaccion = 0.0
    tiempo_total = 100.0

    posiciones = [(105,530), (153,530), (201,530), (249,530)]
    for i in range(total):
        x, y = posiciones[i]
        jugadores.append(Jugador(x, y, colores[i], roles[i]))

def obtener_responsable(objetivo):
    especialista = next((j for j in jugadores if j.nombre == objetivo["rol"]), None)
    if especialista:
        return especialista, False
    director = next((j for j in jugadores if j.nombre == "Director"), None)
    return director, director is not None

def actualizar_interaccion(tecla_activa, dt):
    global mision_actual, progreso_interaccion, estado, tiempo_total

    if estado != "juego":
        return

    if tiempo_total <= 0:
        estado = "fallo"
        return

    tiempo_total -= dt

    if mision_actual >= len(misiones):
        progreso_interaccion = 0.0
        return

    objetivo = misiones[mision_actual]
    responsable, _ = obtener_responsable(objetivo)
    sala_objetivo = salas[objetivo["sala"]]
    en_sector = responsable and responsable.rect.colliderect(sala_objetivo)

    if en_sector and tecla_activa:
        progreso_interaccion += dt
    else:
        progreso_interaccion = 0.0

    if progreso_interaccion >= objetivo["duracion"]:
        mision_actual += 1
        progreso_interaccion = 0.0
        tiempo_total += 5  # suma 5 segundos al temporizador al cumplir misión
        if mision_actual >= len(misiones):
            estado = "final"



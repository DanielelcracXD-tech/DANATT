def dis_recortar(cadena, fnt, ancho):
    """Acorta un texto con puntos suspensivos para que quepa en el ancho indicado."""
    while cadena and fnt.size(cadena)[0] > ancho:
        cadena = cadena[:-2]
        if fnt.size(cadena + "…")[0] <= ancho:
            return cadena + "…"
    return cadena



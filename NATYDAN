# ====================
# JUGADOR
# ====================

class Jugador:

    def __init__(
        self,
        x,
        y,
        color,
        nombre
    ):

        self.x = x
        self.y = y

        self.color = color
        self.nombre = nombre

        self.rect = pygame.Rect(
            x,
            y,
            40,
            50
        )

        self.velocidad = 250

    def mover(
        self,
        teclas,
        controles,
        dt
    ):

        if teclas[controles[0]]:
            self.y -= self.velocidad * dt

        if teclas[controles[1]]:
            self.y += self.velocidad * dt

        if teclas[controles[2]]:
            self.x -= self.velocidad * dt

        if teclas[controles[3]]:
            self.x += self.velocidad * dt

        self.x = max(MAPA.left + 8, min(MAPA.right - 48, self.x))
        self.y = max(MAPA.top + 10, min(MAPA.bottom - 58, self.y))

        self.rect.x = self.x
        self.rect.y = self.y

    def dibujar(self):
        x, y = self.rect.x, self.rect.y
        centro_x = self.rect.centerx

        pygame.draw.ellipse(pantalla, (0, 0, 0, 90), (x + 2, y + 42, 38, 9))
        pygame.draw.rect(pantalla, (24, 35, 53), (x + 1, y + 23, 8, 20), border_radius=3)
        pygame.draw.rect(pantalla, self.color, (x + 8, y + 23, 25, 23), border_radius=8)
        pygame.draw.rect(pantalla, BLANCO, (x + 16, y + 29, 10, 11), border_radius=3)
        pygame.draw.line(pantalla, (220, 232, 245), (x + 11, y + 45), (x + 8, y + 50), 4)
        pygame.draw.line(pantalla, (220, 232, 245), (x + 29, y + 45), (x + 32, y + 50), 4)

        pygame.draw.circle(pantalla, (18, 30, 48), (centro_x, y + 15), 15)
        pygame.draw.circle(pantalla, self.color, (centro_x, y + 14), 13)
        visor = pygame.Rect(x + 9, y + 8, 23, 13)
        pygame.draw.rect(pantalla, (118, 198, 237), visor, border_radius=6)
        pygame.draw.line(pantalla, (224, 248, 255), (x + 13, y + 10), (x + 25, y + 10), 2)

        placa = fuente_mini.render(self.nombre, True, BLANCO)
        placa_rect = placa.get_rect(center=(centro_x, y - 10))
        fondo_placa = placa_rect.inflate(12, 6)
        pygame.draw.rect(pantalla, (8, 17, 31), fondo_placa, border_radius=6)
        pygame.draw.rect(pantalla, self.color, fondo_placa, 1, border_radius=6)
        pantalla.blit(placa, placa_rect)


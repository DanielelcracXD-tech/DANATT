            hv, sl = c["hv"][j], c["sel"][j]
            acento = VERDE if c["bloqueado"] else AMARILLO
            rect_alpha(pantalla, BLANCO, rect, (5 + 16 * hv) * a_in, 7)
            if sl > 0.01:
                rect_alpha(pantalla, acento, rect, 38 * sl * a_in, 7)

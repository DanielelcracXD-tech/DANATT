# ====================
# LOOP
# ====================

while True:
    dt = clock.tick(60)/1000
    tiempo = pygame.time.get_ticks() / 1000
    mouse = pygame.mouse.get_pos()

    for evento in pygame.event.get():
        if evento.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if evento.type == pygame.MOUSEBUTTONDOWN and evento.button == 1 and estado == "menu":
            for indice, boton in enumerate(botones_menu):
                if boton.collidepoint(evento.pos):
                    crear_jugadores(indice + 1)
                    estado = "juego"
                    break

        if evento.type == pygame.KEYDOWN:
            if estado == "menu" and pygame.K_1 <= evento.key <= pygame.K_4:
                crear_jugadores(evento.key - pygame.K_0)
                estado = "juego"
            elif estado == "juego" and evento.key == pygame.K_ESCAPE:
                estado = "menu"
                jugadores.clear()
            elif estado == "juego" and evento.key == pygame.K_e and mision_actual < len(misiones):
                objetivo = misiones[mision_actual]
                for jugador in jugadores:
                    if (jugador.nombre == objetivo["rol"]
                            and jugador.rect.colliderect(salas[objetivo["sala"]])):
                        mision_actual += 1
                        break
                if mision_actual >= len(misiones):
                    estado = "final"
            elif estado == "final" and evento.key in (pygame.K_RETURN, pygame.K_r):
                estado = "menu"
                jugadores.clear()

    if estado == "menu":
        dibujar_menu(mouse, tiempo)
    elif estado == "juego":
        teclas = pygame.key.get_pressed()
        dibujar_fondo(tiempo)
        dibujar_cabecera()
        mostrar_mision()
        dibujar_nave(tiempo, mouse)
        dibujar_tripulacion()

        for indice, jugador in enumerate(jugadores):
            jugador.mover(teclas, controles[indice], dt)
            jugador.dibujar()

        if mision_actual < len(misiones):
            objetivo = misiones[mision_actual]
            sala_objetivo = salas[objetivo["sala"]]
            responsable = next((j for j in jugadores if j.nombre == objetivo["rol"]), None)
            if responsable and responsable.rect.colliderect(sala_objetivo):
                aviso = fuente_mediana.render("E  ·  COMPLETAR OBJETIVO", True, (10, 25, 38))
                placa = aviso.get_rect(center=(sala_objetivo.centerx, sala_objetivo.bottom + 27))
                pygame.draw.rect(pantalla, AMARILLO, placa.inflate(24, 12), border_radius=9)
                pantalla.blit(aviso, placa)
    elif estado == "final":
        dibujar_final()

    pygame.display.flip()

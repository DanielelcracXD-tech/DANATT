"""Lanzador de Apollo 13 mejorado.

Coloca este archivo, parche_apolo13.py y banco_apolo13.py en la MISMA carpeta
que tu juego original (con alarm.mp3, inicio.mp3, message.mp3 y end.mp3).
Cambia JUEGO_ORIGINAL por el nombre real de tu archivo y ejecuta:

    python jugar_apolo13.py
"""

import importlib.util
import os
import sys
from pathlib import Path

JUEGO_ORIGINAL = "nattequiero.py"   # <-- nombre de tu archivo original

AQUI = Path(__file__).resolve().parent
ruta = AQUI / JUEGO_ORIGINAL
if not ruta.exists():
    sys.exit(f"No encuentro {ruta}. Ajusta JUEGO_ORIGINAL en jugar_apolo13.py.")

os.chdir(AQUI)
sys.path.insert(0, str(AQUI))

spec = importlib.util.spec_from_file_location("apollo13_base", ruta)
J = importlib.util.module_from_spec(spec)
sys.modules["apollo13_base"] = J
spec.loader.exec_module(J)

parche = AQUI / "parche_apolo13.py"
exec(compile(parche.read_text(encoding="utf-8"), str(parche), "exec"), J.__dict__)

J.main()
